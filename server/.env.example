# GainChek v2 — Server Environment Variables
# Copy this file to server/.env and fill in your values

# ─── Database ────────────────────────────────────────────────────────────────
# PostgreSQL connection string (Supabase connection pooler recommended for serverless/hosted)
DATABASE_URL="postgresql://USER:PASSWORD@HOST:PORT/DATABASE?pgbouncer=true"

# ─── Auth ────────────────────────────────────────────────────────────────────
# Google OAuth Client ID (must match client's VITE_GOOGLE_CLIENT_ID)
GOOGLE_CLIENT_ID="your-google-client-id.apps.googleusercontent.com"

# JWT signing secret (minimum 32 characters, never use default in production)
JWT_SECRET="generate-a-strong-random-secret-at-least-32-chars-long"

# ─── App URLs ────────────────────────────────────────────────────────────────
# Frontend URL (used for CORS and invitation links)
CLIENT_URL="http://localhost:5173"

# ─── Email (Resend — for coach email sign-up OTP) ────────────────────────────
RESEND_API_KEY="re_your_resend_api_key_here"
RESEND_FROM_EMAIL="GainChek <noreply@yourdomain.com>"

# ─── Server Configuration ────────────────────────────────────────────────────
PORT=3001
NODE_ENV="development"

# Set to true ONLY in local development to enable POST /auth/dev-login
# Startup will fail if this is set to true when NODE_ENV is production
ENABLE_DEV_LOGIN=false
