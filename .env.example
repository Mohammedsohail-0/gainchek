# GainChek v2 — Environment Variables
# Copy this file to .env and fill in your values

# ─── Database ────────────────────────────────────────────────────────────────
# Supabase PostgreSQL connection string (use the pooler URL for production)
DATABASE_URL="postgresql://USER:PASSWORD@HOST:PORT/DATABASE?pgbouncer=true"

# ─── Auth ────────────────────────────────────────────────────────────────────
# Google OAuth Client ID (from Google Cloud Console)
GOOGLE_CLIENT_ID="your-google-client-id.apps.googleusercontent.com"

# JWT signing secret — use a long random string
JWT_SECRET="change-me-to-a-long-random-secret"

# ─── URLs ────────────────────────────────────────────────────────────────────
# Frontend URL (used in invite links)
CLIENT_URL="http://localhost:5173"

# ─── Email (Resend — for coach email sign-up OTP) ────────────────────────────
# Sign up at https://resend.com to get an API key
RESEND_API_KEY="re_your_resend_api_key_here"
# Must be a verified sender domain in your Resend account
RESEND_FROM_EMAIL="GainChek <noreply@yourdomain.com>"

# ─── Server ──────────────────────────────────────────────────────────────────
PORT=3001
